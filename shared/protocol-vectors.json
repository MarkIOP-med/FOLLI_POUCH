{
  "_readme": [
    "FOLLI protocol conformance vectors — the single cross-language source of truth.",
    "Three implementations must agree: POUCH_ESP_GEN4 firmware (C++, anchored by the",
    "bench-captured lines below), POUCH_APP/backend/app/transport/protocol.py (pytest:",
    "tests/test_protocol_vectors.py), and FOLLI_CONSOLE src/services/pouch/protocol.ts",
    "(jest: tests/protocolVectors.test.ts). Change the grammar => change this file =>",
    "both suites fail until every implementation catches up. Wire strings exclude the",
    "trailing newline. Channels are 0-indexed: FRONT=0, TEMPLE=1, EAR=2, BACK=3."
  ],
  "constants": {
    "pressure_ceiling_mmhg": 130,
    "controller_tolerance_mmhg": 3,
    "trim_range_pct": 10,
    "vibration_levels": [
      0,
      3
    ],
    "vibration_leave_unchanged": -1,
    "ble": {
      "service_uuid": "4fafc201-1fb5-459e-8fcc-c5c9c331914b",
      "command_char_uuid": "beb5483e-36e1-4688-b7f5-ea07361b26a8",
      "telemetry_char_uuid": "d68a2a54-7f15-4ba5-bc44-59368d400d3b",
      "advertised_name": "FOLLISAVE-POUCH",
      "min_mtu": 185
    }
  },
  "encode": [
    {
      "name": "start",
      "fn": "start",
      "args": {},
      "wire": "start"
    },
    {
      "name": "stop",
      "fn": "stop",
      "args": {},
      "wire": "stop"
    },
    {
      "name": "reset_all",
      "fn": "reset_all",
      "args": {},
      "wire": "resetall"
    },
    {
      "name": "restart",
      "fn": "restart",
      "args": {},
      "wire": "restart"
    },
    {
      "name": "assign",
      "fn": "assign",
      "args": {},
      "wire": "assign"
    },
    {
      "name": "save_as_default",
      "fn": "save_as_default",
      "args": {},
      "wire": "saveasdefault"
    },
    {
      "name": "pressure_single",
      "fn": "set_pressure",
      "args": {
        "targets": {
          "TEMPLE": 95
        }
      },
      "wire": "setpressure:1,95"
    },
    {
      "name": "pressure_batch",
      "fn": "set_pressure",
      "args": {
        "targets": {
          "TEMPLE": 95,
          "EAR": 125
        }
      },
      "wire": "setpressure:1,95;2,125"
    },
    {
      "name": "pressure_zero",
      "fn": "set_pressure",
      "args": {
        "targets": {
          "BACK": 0
        }
      },
      "wire": "setpressure:3,0"
    },
    {
      "name": "vib_full",
      "fn": "set_vibration",
      "args": {
        "levels": [
          0,
          3,
          2,
          0
        ]
      },
      "wire": "setvibration:0,3,2,0"
    },
    {
      "name": "vib_one_shot",
      "fn": "set_vibration",
      "args": {
        "levels": [
          -1,
          -1,
          2,
          -1
        ]
      },
      "wire": "setvibration:-1,-1,2,-1"
    },
    {
      "name": "vib_clamped",
      "fn": "set_vibration",
      "args": {
        "levels": [
          0,
          5,
          -9,
          2
        ]
      },
      "wire": "setvibration:0,3,-1,2"
    },
    {
      "name": "load_user",
      "fn": "load_user",
      "args": {
        "user_id": 8,
        "pressures": [
          0,
          95,
          125,
          0
        ]
      },
      "wire": "user:8:0,95,125,0"
    },
    {
      "name": "load_user_named",
      "fn": "load_user",
      "args": {
        "user_id": 7,
        "pressures": [
          0,
          40,
          60,
          0
        ],
        "name": "Edna Levi"
      },
      "wire": "user:7:0,40,60,0:Edna Levi"
    },
    {
      "name": "user_default",
      "fn": "set_user_default_pressure",
      "args": {
        "pressures": [
          0,
          95,
          125,
          0
        ]
      },
      "wire": "setuserdefaultpressure:0,95,125,0"
    },
    {
      "name": "set_variable",
      "fn": "set_variable",
      "args": {
        "variable": "TELEMETRY_INTERVAL",
        "value": 500
      },
      "wire": "setvariable:TELEMETRY_INTERVAL,500"
    },
    {
      "name": "set_variable_default",
      "fn": "set_variable",
      "args": {
        "variable": "PRESSURE_TOLERANCE",
        "value": "default"
      },
      "wire": "setvariable:PRESSURE_TOLERANCE,default"
    },
    {
      "name": "read_user",
      "fn": "read",
      "args": {
        "what": "user"
      },
      "wire": "readuser"
    },
    {
      "name": "read_pressure",
      "fn": "read",
      "args": {
        "what": "pressure"
      },
      "wire": "readpressure"
    },
    {
      "name": "read_state",
      "fn": "read",
      "args": {
        "what": "state"
      },
      "wire": "readstate"
    }
  ],
  "decode_serial": [

      }
    },
    {
      "name": "empty_prefix_is_log",
      "line": "T:",
      "expect": {
        "kind": "log"
      }
    }
  ],
  "decode_ble": [
    {
      "_comment": "BLE periodic telemetry — consumed by the console's protocol.ts only (Python never parses BLE lines).",

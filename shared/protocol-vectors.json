        "tag": "OK",
        "payload": "SETPRESSURE:1,95"
      }
    },
    {
      "name": "err_line",
      "line": "ERR:SETPRESSURE:channel out of range (7)",
      "expect": {
        "kind": "response",
        "tag": "ERR",
        "payload": "SETPRESSURE:channel out of range (7)"
      }
    },
    {
      "name": "read_user_response",
      "line": "R:USER:8,true,0,95,125,0",
      "expect": {
        "kind": "response",
        "tag": "R",
